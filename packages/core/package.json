{
  "name": "habemus-papam",
  "version": "1.1.0",
  "description": "Returns information about the current pope of the Catholic Church.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "bin",
    "dist",
    "CHANGELOG.md"
  ],
  "bin": {
    "habemus-papam": "bin/cli.js"
  },
  "type": "module",
  "keywords": [
    "pope",
    "vatican",
    "catholic",
    "church",
    "habemus papam",
    "leo xiv"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs && node ../cli/build.mjs",
    "typecheck": "tsc --project tsconfig.types.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "author": "Vinicius Souza",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viniciuspizettadesouza/habemus-papam.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/viniciuspizettadesouza/habemus-papam/issues"
  },
  "homepage": "https://github.com/viniciuspizettadesouza/habemus-papam/tree/main/packages/core#readme",
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
