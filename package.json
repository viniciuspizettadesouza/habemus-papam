{
  "name": "habemus-papam",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build:extension": "pnpm --filter @habemus-papam/extension build",
    "zip-extension": "pnpm build:extension && cd packages/extension/dist && zip -FSr ../../../habemus-papam-extension.zip .",
    "publish-core": "pnpm --filter habemus-papam publish --access public",
    "bump-patch": "pnpm --filter habemus-papam version patch",
    "bump-minor": "pnpm --filter habemus-papam version minor",
    "bump-major": "pnpm --filter habemus-papam version major",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release-packages": "changeset publish",
    "build:core": "pnpm --filter habemus-papam build",
    "build:cli": "pnpm --filter @habemus-papam/cli build",
    "start:cli": "pnpm --filter @habemus-papam/cli start",
    "typecheck": "pnpm --filter habemus-papam typecheck",
    "test": "pnpm build:core && pnpm typecheck && pnpm -r --if-present test",
    "test:coverage": "pnpm build:core && pnpm typecheck && pnpm -r --if-present test:coverage"
  },
  "packageManager": "pnpm@10.11.0",
  "devDependencies": {
    "@changesets/cli": "^2.29.4"
  }
}
